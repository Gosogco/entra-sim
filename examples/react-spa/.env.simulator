# Configuration for entra-sim. Copy this to .env, then fill in the client ID.
#
#   terraform output -raw env > .env     writes a complete file, including the client ID
#   CA=../../certs/ca.pem scripts/setup.sh > .env    the same thing without Terraform

# From `terraform output -raw client_id`, or from scripts/setup.sh.
VITE_CLIENT_ID=

# The simulator is its own authority and its own Graph.
VITE_AUTHORITY=https://localhost:8443/00000000-0000-0000-0000-000000000001
VITE_GRAPH_BASE=https://localhost:8443

VITE_SCOPES=User.Read

# The instance-discovery answer MSAL would otherwise ask Microsoft for. Supplying it inline
# means MSAL never leaves the simulator. Must not be set against a real tenant.
VITE_CLOUD_DISCOVERY_METADATA={"tenant_discovery_endpoint":"https://localhost:8443/00000000-0000-0000-0000-000000000001/v2.0/.well-known/openid-configuration","api-version":"1.1","metadata":[{"preferred_network":"localhost:8443","preferred_cache":"localhost:8443","aliases":["localhost:8443"]}]}
