# Configuration for a real Microsoft Entra tenant. Copy this to .env and fill in the two values.
#
# The source code is identical to the simulator run. Only this file differs.

# From `terraform output -raw client_id` after applying against the real tenant, or from the
# app registration in the portal.
VITE_CLIENT_ID=

# Your tenant ID.
VITE_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000

VITE_GRAPH_BASE=https://graph.microsoft.com

VITE_SCOPES=User.Read

# Deliberately absent. MSAL must use Microsoft's own instance-discovery service here, and
# supplying a fixed answer would stop it doing so.
# VITE_CLOUD_DISCOVERY_METADATA=
